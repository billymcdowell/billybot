{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "billybot",
  "version": "0.1.0",
  "identifier": "uk.billymcdowell.billybot",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "billybot",
        "width": 1100,
        "height": 750
      }
    ],
    "security": {
      "csp": {
      "default-src": "'self'",
      "script-src": "'self' 'wasm-unsafe-eval'",
      "style-src": "'self' 'unsafe-inline'",
      "img-src": "'self' data:",
      "font-src": "'self' data:",
      "media-src": "'self' blob:",
      "connect-src": "'self' ipc: http://ipc.localhost https://openrouter.ai ws://localhost:1420 http://localhost:1420",
      "object-src": "'none'",
      "base-uri": "'self'",
      "form-action": "'none'",
      "frame-ancestors": "'none'"
    }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
